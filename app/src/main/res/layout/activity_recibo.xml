<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:orientation="vertical"
android:padding="24dp"
android:gravity="center_horizontal"
android:background="@drawable/fondo">

    <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Registrar Recibo"
    android:textColor="#FFFFFF"
    android:textSize="28sp"
    android:textStyle="bold"
    android:layout_marginTop="40dp"
    android:layout_marginBottom="32dp" />

<!-- Nombre del recibo (Agua, Luz, etc.) -->
<EditText
    android:id="@+id/etNombreRecibo"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:hint="Nombre del recibo (Ej: Luz, Agua)"
    android:inputType="text"
    android:background="#FFFFFF"
    android:padding="14dp"
    android:layout_marginBottom="16dp" />

<!-- Monto del recibo -->
<EditText
    android:id="@+id/etMontoRecibo"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:hint="Monto estimado (S/)"
    android:inputType="numberDecimal"
    android:background="#FFFFFF"
    android:padding="14dp"
    android:layout_marginBottom="16dp" />

<!-- Fecha de Vencimiento -->
<EditText
    android:id="@+id/etFechaVencimiento"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:hint="Fecha de Vencimiento"
    android:focusable="false"
    android:clickable="true"
    android:background="#FFFFFF"
    android:padding="14dp"
    android:layout_marginBottom="32dp" />

<!-- Botón para Guardar -->
<Button
    android:id="@+id/btnGuardarRecibo"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="GUARDAR RECIBO"
    android:backgroundTint="#0F4C2A"
    android:textColor="#FFFFFF"
    android:textStyle="bold"
    android:padding="14dp" />

</LinearLayout>
